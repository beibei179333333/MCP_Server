# G789 Telegram bot — copy to .env and fill in. NEVER commit the real .env.
# Required
TELEGRAM_BOT_TOKEN=123456789:AA...your-bot-token-from-@BotFather
ANTHROPIC_API_KEY=sk-ant-...your-anthropic-api-key

# Optional (defaults shown)
ANTHROPIC_MODEL=claude-opus-4-8
G789_EFFORT=medium                 # low | medium | high | max
G789_MAX_HISTORY_TURNS=16
G789_MAX_OUTPUT_TOKENS=4000
# Hide whole categories from the bot (comma-separated), e.g. 黄,赌
G789_BLOCKED_CATEGORIES=
# Telegram numeric user IDs allowed to use admin features (reserved; comma-separated)
G789_ADMIN_IDS=
