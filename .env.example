# ===== 2026 世界杯 Telegram 机器人 配置示例 =====
# 复制本文件为 .env 后按需修改：  cp .env.example .env
# 注意：.env 已在 .gitignore 中忽略，不会被提交。

# 【必填】BotFather 给你的机器人 Token（在 Telegram 里找 @BotFather → /newbot）
TELEGRAM_BOT_TOKEN=

# 【可选】football-data.org 免费 API Key（真实赛事数据）。
# 不填则自动进入「演示模式」，用模拟数据体验全部通知功能。
# 申请：https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# 数据源：football-data（真实，需要上面的 Key）或 demo（演示，无需联网）
PROVIDER=football-data

# football-data 的赛事代码，世界杯为 WC
COMPETITION=WC

# 轮询间隔（秒）。免费 API 限 10 次/分钟，建议 60。
POLL_INTERVAL_SECONDS=60

# 开赛前多少分钟发提醒
REMINDER_MINUTES=15

# 显示时区（IANA 名称），例如 Asia/Shanghai、Europe/London、UTC
TIMEZONE=Asia/Shanghai

# 默认语言：zh 或 en（用户可用 /lang 自行切换）
DEFAULT_LANG=zh

# 数据库文件路径（保存订阅者与赛事状态）
DB_PATH=worldcup_bot.db

# 【可选】管理员 chat id，设置后该会话可用 /broadcast 群发公告
# 用 /whoami 命令可以查到自己的 chat id
ADMIN_CHAT_ID=
