[Unit]
Description=2026 World Cup Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/worldcup-bot
EnvironmentFile=/opt/worldcup-bot/.env
ExecStart=/opt/worldcup-bot/.venv/bin/python -m worldcup_bot run
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
